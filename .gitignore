```gitignore
# Dependencies
node_modules/
.pnpm-store/
.npm/
.yarn/
.yarn-cache/

# Build outputs
dist/
build/
.out/
.bundle/

# TypeScript/JavaScript
*.js.map
*.ts.map
*.jsx.map
*.tsx.map

# Temporary files
*.tmp
*.temp
*.log
.DS_Store
Thumbs.db

# Environment variables
.env
.env.local
.env.*
!.env.example

# IDE specific
.vscode/
.idea/
*.swp
*.swo

# Python (if applicable)
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
venv/
.venv/
.env/
pip-log.txt
pip-delete-this-directory.txt
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.log
.git/
!.git/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
```